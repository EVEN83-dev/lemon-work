                    if not raw_line:
                        continue
                    line_str = raw_line.decode("utf-8", errors="replace") if isinstance(raw_line, bytes) else raw_line
                    if not line_str.startswith("data:"):
                        continue
                    data_str = line_str[5:].strip()
                    if data_str == "[DONE]":
                        break
                    try:
                        chunk = json.loads(data_str)
                    except json.JSONDecodeError:
                        continue
                    choices = chunk.get("choices", []) or []
                    if not choices:
                        continue
                    delta = choices[0].get("delta", {}) or {}
                    token = delta.get("content", "") or ""
                    if token:
                        content_parts.append(token)
                        try:
                            stream_callback(token)
                        except Exception:
                            pass
                    delta_tcs = delta.get("tool_calls", []) or []
                    for dtc in delta_tcs:
                        idx = dtc.get("index", 0)
                        slot = tc_accum.setdefault(idx, {"id": "", "name": "", "args_str": ""})
                        if dtc.get("id"):
                            slot["id"] = dtc["id"]
                        func = dtc.get("function", {}) or {}
                        if func.get("name"):
                            slot["name"] = func["name"]
                        if func.get("arguments"):
                            slot["args_str"] += func["arguments"]
            else:
                resp = self._get_session().post(
                    self._api_url(), json=payload, headers=self._headers(),
                    timeout=self.config.timeout,
                )
                resp.raise_for_status()
                data = resp.json()
                choices = data.get("choices", [])
                if choices:
                    msg = choices[0].get("message", {})
                    content_parts = [msg.get("content", "") or ""]
                    for i, tc in enumerate(msg.get("tool_calls", []) or []):
                        func = tc.get("function", {})
                        tc_accum[i] = {
                            "id": tc.get("id", ""),
                            "name": func.get("name", ""),
                            "args_str": func.get("arguments", "{}") or "{}",
                        }
                else:
                    content_parts = [""]
        except Exception as e:
            if use_stream:
                payload["stream"] = False
                resp = self._get_session().post(
                    self._api_url(), json=payload, headers=self._headers(),
                    timeout=self.config.timeout,
                )
                resp.raise_for_status()
                data = resp.json()
                choices = data.get("choices", [])
                if choices:
                    msg = choices[0].get("message", {})
                    content_parts = [msg.get("content", "") or ""]
                    tc_accum = {}
                    for i, tc in enumerate(msg.get("tool_calls", []) or []):
                        func = tc.get("function", {})
                        tc_accum[i] = {
                            "id": tc.get("id", ""),
                            "name": func.get("name", ""),
                            "args_str": func.get("arguments", "{}") or "{}",
                        }
                else:
                    content_parts = [""]
            else:
                raise

        content = "".join(content_parts)
        raw_tool_calls = []
        for idx in sorted(tc_accum.keys()):
            slot = tc_accum[idx]
            raw_tool_calls.append({
                "id": slot["id"],
                "function": {"name": slot["name"], "arguments": slot["args_str"]},
            })
        tool_calls = _normalize_tool_calls(raw_tool_calls)
        return {"content": content, "tool_calls": tool_calls}

    def list_models(self) -> List[str]:
        if self._models:
            return self._models
        if self.config.api_key:
            try:
                base = self.config.api_base.rstrip("/")
                resp = requests.get(f"{base}/models", headers=self._headers(), timeout=5)
                if resp.status_code == 200:
                    data = resp.json().get("data", [])
                    return [m.get("id", "") for m in data if m.get("id")]
            except Exception:
                pass
        return [self.config.model] if self.config.model else []

    def is_available(self) -> bool:
        if not self.config.api_base:
            return False
        try:
            base = self.config.api_base.rstrip("/")
            resp = requests.get(f"{base}/models", headers=self._headers(), timeout=5)
            return resp.status_code == 200
        except Exception:
            return bool(self.config.api_key)

    def cleanup(self):
        if self._session:
            self._session.close()
            self._session = None

