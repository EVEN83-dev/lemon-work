                "content": f"MIMO Code 工具调用失败: {e}",
                "tool_calls": [],
                "model": model or "mimo",
            }

    def _parse_tool_calls_from_content(self, content: str) -> List[Dict]:
        """
        ★ v3.67: 从模型输出中解析工具调用 JSON

        支持格式：
        - ```json\n{"tool_calls": [...]}\n```
        - {"tool_calls": [...]}
        - 带前后说明文字的 JSON 块
        """
        if not content or "tool_calls" not in content:
            return []

        import re
        import json as _json

        # 尝试从 ```json ... ``` 块中提取
        json_blocks = re.findall(r"```(?:json)?\s*\n?(.*?)\n?```", content, re.DOTALL)
        for block in json_blocks:
            try:
                parsed = _json.loads(block.strip())
                if isinstance(parsed, dict) and "tool_calls" in parsed:
                    tcs = parsed["tool_calls"]
                    if isinstance(tcs, list):
                        # 标准化格式
                        normalized = []
                        for i, tc in enumerate(tcs):
                            if isinstance(tc, dict) and "name" in tc:
                                normalized.append({
                                    "id": tc.get("id", f"call_{i}"),
                                    "name": tc["name"],
                                    "arguments": tc.get("arguments", {}),
                                })
                        return normalized
            except _json.JSONDecodeError:
                continue

        # 尝试直接解析整个内容
        try:
            # 找到第一个 { 和最后一个 }
            first = content.find("{")
            last = content.rfind("}")
            if first >= 0 and last > first:
                json_str = content[first:last + 1]
                parsed = _json.loads(json_str)
                if isinstance(parsed, dict) and "tool_calls" in parsed:
                    tcs = parsed["tool_calls"]
                    if isinstance(tcs, list):
                        normalized = []
                        for i, tc in enumerate(tcs):
                            if isinstance(tc, dict) and "name" in tc:
                                normalized.append({
                                    "id": tc.get("id", f"call_{i}"),
                                    "name": tc["name"],
                                    "arguments": tc.get("arguments", {}),
                                })
                        return normalized
        except _json.JSONDecodeError:
            pass

        return []

    def is_available(self) -> bool:
        """检查引擎是否可用
        
        ★ v3.60: 优先检查 mimo.exe 文件是否存在（serve_bridge 会启动它）
