class LemonModelEvaluator:
    """Lemon AI Engine 模型评估
    
    评估微调后的模型在代码生成、Agent 工具调用等方面的表现。
    使用 HumanEval、MBPP 等标准基准 + 自定义测试集。
    """
    
    # 自定义 Lemon 测试集（Agent 工具调用）
    LEMON_TOOL_CALL_TEST = [
        {
            "task": "读取文件内容",
            "prompt": "请读取 d:/test.py 文件的内容",
            "expected_tool": "read_file",
            "expected_args": {"path": "d:/test.py"},
        },
        {
            "task": "搜索代码",
            "prompt": "在项目中搜索 'def main' 函数",
            "expected_tool": "search_files",
            "expected_args": {"pattern": "def main"},
        },
        {
            "task": "执行代码",
            "prompt": "执行 Python 代码 print('hello')",
            "expected_tool": "execute_code",
            "expected_args": {"code": "print('hello')", "language": "python"},
        },
        {
            "task": "Git 提交",
            "prompt": "提交当前修改，信息为 'fix: bug'",
            "expected_tool": "git_commit",
            "expected_args": {"message": "fix: bug"},
        },
        {
            "task": "网页搜索",
            "prompt": "搜索 Python 3.12 新特性",
            "expected_tool": "web_search",
            "expected_args": {"query": "Python 3.12 新特性"},
        },
    ]
    
    @staticmethod
    def evaluate_tool_calling(inference: LemonInferenceService) -> Dict:
        """评估工具调用能力"""
        results = []
        for test in LemonModelEvaluator.LEMON_TOOL_CALL_TEST:
            try:
                response = inference.generate(test["prompt"])
                tool_called = test["expected_tool"] in response
                results.append({
                    "task": test["task"],
                    "passed": tool_called,
                    "response_preview": response[:100] if response else "(empty)",
                })
            except Exception as e:
                results.append({
                    "task": test["task"],
                    "passed": False,
                    "error": str(e),
                })
        
        passed = sum(1 for r in results if r["passed"])
        total = len(results)
        return {
            "benchmark": "Lemon Tool Calling",
            "total": total,
            "passed": passed,
            "accuracy": f"{passed/total*100:.1f}%" if total > 0 else "N/A",
            "details": results,
        }
    
    @staticmethod
    def evaluate_code_generation(inference: LemonInferenceService) -> Dict:
        """评估代码生成能力（简化版 HumanEval 风格）"""
        test_cases = [
            {
                "name": "快速排序",
                "prompt": "用 Python 写一个快速排序函数 quicksort(arr)",
                "checks": ["def quicksort", "pivot", "return"],
            },
            {
                "name": "二分查找",
                "prompt": "用 Python 写一个二分查找函数 binary_search(arr, target)",
                "checks": ["def binary_search", "mid", "while"],
            },
            {
                "name": "斐波那契",
                "prompt": "用 Python 写一个斐波那契数列函数 fibonacci(n)",
                "checks": ["def fibonacci", "return"],
            },
            {
                "name": "HTTP 请求",
                "prompt": "用 Python requests 写一个 GET 请求示例",
                "checks": ["import requests", "requests.get"],
            },
            {
                "name": "文件读取",
                "prompt": "用 Python 写一个读取文件并打印内容的函数",
                "checks": ["open", "with", "read"],
            },
        ]
        
        results = []
        for tc in test_cases:
            try:
                response = inference.generate(tc["prompt"])
                passed = all(check in response for check in tc["checks"]) if response else False
                results.append({
                    "name": tc["name"],
                    "passed": passed,
                    "response_preview": response[:150] if response else "(empty)",
                })
            except Exception as e:
                results.append({"name": tc["name"], "passed": False, "error": str(e)})
        
        passed = sum(1 for r in results if r["passed"])
        total = len(results)
        return {
            "benchmark": "Lemon Code Generation",
            "total": total,
            "passed": passed,
            "accuracy": f"{passed/total*100:.1f}%" if total > 0 else "N/A",
            "details": results,
        }
    
    @staticmethod
    def run_full_evaluation(inference: LemonInferenceService) -> Dict:
        """运行完整评估"""
        print("[LemonEvaluator] 开始评估...")
        
        tool_result = LemonModelEvaluator.evaluate_tool_calling(inference)
        code_result = LemonModelEvaluator.evaluate_code_generation(inference)
        
        total_tests = tool_result["total"] + code_result["total"]
        total_passed = tool_result["passed"] + code_result["passed"]
        
        return {
            "model": inference.config.model_path,
            "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
            "overall_accuracy": f"{total_passed/total_tests*100:.1f}%" if total_tests > 0 else "N/A",
            "tool_calling": tool_result,
            "code_generation": code_result,
        }


