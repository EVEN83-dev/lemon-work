class LemonInferenceService:
    """Lemon AI Engine 推理服务
    
    通过 Ollama 运行微调后的 Lemon 模型，提供流式和非流式推理。
    与现有 EngineManager 兼容，可作为独立引擎注册。
    """
    
    def __init__(self, config: LemonEngineConfig = None):
        self.config = config or LemonEngineConfig()
        self.status = LemonEngineStatus()
        self._session = None
        self._lock = threading.Lock()
        self._callbacks = {
            "on_token": None,
            "on_complete": None,
            "on_thinking": None,
            "on_error": None,
        }
        self._cancel_flag = threading.Event()
    
    def _get_session(self):
        """获取或创建 HTTP Session"""
        if self._session is None:
            import requests
            self._session = requests.Session()
            self._session.headers.update({
                "Content-Type": "application/json",
                "Connection": "keep-alive",
            })
        return self._session
    
    def check_health(self) -> Dict:
        """检查模型健康状态"""
        try:
            import requests
            resp = requests.get(
                f"{self.config.ollama_host}/api/tags",
                timeout=5
            )
            if resp.status_code == 200:
                models = resp.json().get("models", [])
                model_names = [m["name"] for m in models]
                self.status.model_loaded = any(
                    self.config.model_path.split(":")[0] in name 
                    for name in model_names
                )
                if self.status.model_loaded:
                    matched = [n for n in model_names 
                              if self.config.model_path.split(":")[0] in n]
                    self.status.model_name = matched[0]
                return {"healthy": self.status.model_loaded, "models": model_names}
            return {"healthy": False, "error": f"HTTP {resp.status_code}"}
        except Exception as e:
            return {"healthy": False, "error": str(e)}
    
    def generate(self, prompt: str, context: List[Dict] = None) -> str:
        """非流式生成"""
        messages = self._build_messages(prompt, context)
        try:
            import requests
            resp = requests.post(
                f"{self.config.ollama_host}/api/chat",
                json={
                    "model": self.config.model_path,
                    "messages": messages,
                    "stream": False,
                    "options": {
                        "temperature": self.config.temperature,
                        "num_predict": self.config.max_tokens,
                    },
                },
                timeout=120,
            )
            if resp.status_code == 200:
                content = resp.json().get("message", {}).get("content", "")
                self.status.successful_requests += 1
                self.status.total_requests += 1
                self.status.last_request_time = time.time()
                return content
            else:
                self.status.failed_requests += 1
                self.status.total_requests += 1
                return ""
        except Exception as e:
            self.status.failed_requests += 1
            self.status.total_requests += 1
            if self._callbacks["on_error"]:
                self._callbacks["on_error"](str(e))
            return ""
    
    def generate_stream(self, prompt: str, context: List[Dict] = None):
        """流式生成（在子线程中运行）"""
        self._cancel_flag.clear()
        messages = self._build_messages(prompt, context)
        
        def _stream():
            try:
                import requests
                start_time = time.time()
                token_count = 0
                
                resp = requests.post(
                    f"{self.config.ollama_host}/api/chat",
                    json={
                        "model": self.config.model_path,
                        "messages": messages,
                        "stream": True,
                        "options": {
                            "temperature": self.config.temperature,
                            "num_predict": self.config.max_tokens,
                        },
                    },
                    timeout=300,
                    stream=True,
                )
                
                full_content = ""
                for line in resp.iter_lines():
                    if self._cancel_flag.is_set():
                        break
                    if line:
                        try:
                            data = json.loads(line.decode("utf-8"))
                            message = data.get("message", {})
                            content = message.get("content", "")
                            thinking = data.get("thinking", "")
                            
                            if thinking and self._callbacks["on_thinking"]:
                                self._callbacks["on_thinking"](thinking)
                            
                            if content:
                                full_content += content
                                token_count += 1
                                if self._callbacks["on_token"]:
                                    self._callbacks["on_token"](content)
                        except json.JSONDecodeError:
                            continue
                
                elapsed = time.time() - start_time
                self.status.tokens_per_second = token_count / max(elapsed, 0.1)
                self.status.successful_requests += 1
                self.status.total_requests += 1
                self.status.last_request_time = time.time()
                self.status.avg_response_time = (
                    self.status.avg_response_time * 0.9 + elapsed * 0.1
                )
                
                if self._callbacks["on_complete"]:
                    self._callbacks["on_complete"](full_content)
                    
            except Exception as e:
                self.status.failed_requests += 1
                self.status.total_requests += 1
                if self._callbacks["on_error"]:
                    self._callbacks["on_error"](str(e))
        
        t = threading.Thread(target=_stream, daemon=True)
        t.start()
        return t
    
    def cancel(self):
        """取消当前生成"""
        self._cancel_flag.set()
    
    def on_token(self, callback):
        self._callbacks["on_token"] = callback
    
    def on_complete(self, callback):
        self._callbacks["on_complete"] = callback
    
    def on_thinking(self, callback):
        self._callbacks["on_thinking"] = callback
    
    def on_error(self, callback):
        self._callbacks["on_error"] = callback
    
    def _build_messages(self, prompt: str, context: List[Dict] = None) -> List[Dict]:
        messages = [{"role": "system", "content": self.config.system_prompt}]
        if context:
            messages.extend(context)
        messages.append({"role": "user", "content": prompt})
        return messages


