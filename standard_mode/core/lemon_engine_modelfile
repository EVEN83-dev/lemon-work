class LemonTrainingOrchestrator:
    """Lemon AI Engine 训练编排器
    
    编排从数据收集到部署上线的完整流程。
    每个阶段可独立运行，也可一键执行全流程。
    
    使用方式:
        orchestrator = LemonTrainingOrchestrator()
        orchestrator.check_ready()  # 检查各阶段准备状态
        orchestrator.run_phase("data_collection")  # 执行单个阶段
    """
    
    def __init__(self, config: TrainingConfig = None):
        self.config = config or TrainingConfig()
        self.phases = {
            "data_collection": self._phase_data_collection,
            "data_preprocess": self._phase_data_preprocess,
            "sft": self._phase_sft,
            "dpo": self._phase_dpo,
            "evaluation": self._phase_evaluation,
            "quantization": self._phase_quantization,
            "deployment": self._phase_deployment,
        }
        self._phase_results = {}
    
    def check_ready(self) -> Dict:
        """检查各阶段准备状态"""
        status = {}
        
        # 检查数据收集
        try:
            from core.interaction_logger import get_interaction_logger
            logger = get_interaction_logger()
            stats = logger.get_stats() if logger else {}
            status["data_collection"] = {
                "ready": True,
                "interactions": stats.get("total_interactions", 0),
                "note": f"当前有 {stats.get('total_interactions', 0)} 条交互记录",
            }
        except ImportError:
            status["data_collection"] = {"ready": False, "note": "InteractionLogger 不可用"}
        
        # 检查训练数据
        train_path = self.config.train_data_path
        if os.path.exists(train_path):
            with open(train_path, "r", encoding="utf-8") as f:
                count = sum(1 for _ in f)
            status["data_preprocess"] = {
                "ready": count >= 100,
                "samples": count,
                "note": f"训练数据: {count} 条" + (" (足够)" if count >= 100 else " (不足，建议 >= 100)"),
            }
        else:
            status["data_preprocess"] = {"ready": False, "note": "训练数据文件不存在"}
        
        # 检查 GPU
        status["sft"] = {
            "ready": False,
            "note": "需要 GPU 环境（RTX 3060 12GB 起步）",
            "frameworks": "Unsloth + TRL + bitsandbytes",
        }
        
        status["dpo"] = {"ready": False, "note": "需要偏好数据（点赞/点踩记录）"}
        status["evaluation"] = {"ready": True, "note": "评估脚本就绪"}
        status["quantization"] = {"ready": False, "note": "需要 llama.cpp 编译环境"}
        status["deployment"] = {"ready": False, "note": "需要 GGUF 模型文件"}
        
        return status
    
    def run_phase(self, phase_name: str) -> Dict:
        """执行单个阶段"""
        if phase_name not in self.phases:
            return {"success": False, "error": f"未知阶段: {phase_name}"}
        
        print(f"\n[LemonOrchestrator] ====== Phase: {phase_name} ======")
        result = self.phases[phase_name]()
        self._phase_results[phase_name] = result
        return result
    
    def run_all(self) -> Dict:
        """一键执行全流程"""
        results = {}
        for phase_name in self.phases:
            if phase_name in ["sft", "dpo", "quantization"]:
                print(f"[LemonOrchestrator] 跳过 {phase_name} (需要 GPU 环境)")
                results[phase_name] = {"status": "skipped", "reason": "需要 GPU 环境"}
                continue
            results[phase_name] = self.run_phase(phase_name)
        return results
    
    def _phase_data_collection(self) -> Dict:
        """Phase 1: 数据收集"""
        print("[Phase 1] 从 InteractionLogger 收集高质量对话数据...")
        try:
            from core.interaction_logger import get_interaction_logger
            logger = get_interaction_logger()
            stats = logger.get_stats() if logger else {"total_interactions": 0}
            return {"success": True, "stats": stats}
        except Exception as e:
            return {"success": False, "error": str(e)}
    
    def _phase_data_preprocess(self) -> Dict:
        """Phase 2: 数据预处理"""
        print("[Phase 2] 将对话数据转换为 ChatML 格式...")
        try:
            from core.lemon_trainer import create_training_dataset
            count = create_training_dataset(
                source_file=os.path.join(
                    os.path.dirname(__file__), "..", "..", "data", "interactions.json"
                ),
                output_file=self.config.train_data_path,
                quality_threshold=7.0,
                max_samples=1000,
            )
            return {"success": True, "samples": count}
        except Exception as e:
            return {"success": False, "error": str(e)}
    
    def _phase_sft(self) -> Dict:
        """Phase 3: 监督微调"""
        print("[Phase 3] QLoRA 微调 Qwen2.5-Coder...")
        return {
            "success": False,
            "message": "需要 GPU 环境。请运行: python lemon_trainer.py --train",
            "config": {
                "base_model": self.config.base_model,
                "method": "QLoRA" if self.config.use_qlora else "LoRA",
                "lora_r": self.config.lora_r,
                "epochs": self.config.num_epochs,
                "compute_requirement": "RTX 3060 12GB (QLoRA) / RTX 4090 24GB (LoRA)",
            },
        }
    
    def _phase_dpo(self) -> Dict:
        """Phase 4: DPO 对齐"""
        print("[Phase 4] DPO 偏好对齐...")
        return {"success": False, "message": "需要偏好数据，暂未实现"}
    
    def _phase_evaluation(self) -> Dict:
        """Phase 5: 评估"""
        print("[Phase 5] 模型评估...")
        return {
            "success": True,
            "message": "评估框架就绪。运行: python lemon_engine.py --eval",
            "benchmarks": ["HumanEval", "MBPP", "Lemon Tool Calling", "Lemon Code Generation"],
        }
    
    def _phase_quantization(self) -> Dict:
        """Phase 6: 量化"""
        print("[Phase 6] GGUF 量化...")
        return {"success": False, "message": "需要 llama.cpp 环境"}
    
    def _phase_deployment(self) -> Dict:
        """Phase 7: 部署"""
        print("[Phase 7] 部署到 Ollama...")
        return {
            "success": False,
            "message": "需要 GGUF 模型文件。部署命令: ollama create lemon-code:latest -f Modelfile",
        }


